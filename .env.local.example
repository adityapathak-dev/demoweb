# Excel Academy — Environment Variables

# Gemini API Key — required for the AI chatbot assistant.
# Get your free key at: https://aistudio.google.com/
#
# Copy this file to .env.local and fill in your key:
#   cp .env.local.example .env.local
#
# For Vercel deployment, add GEMINI_API_KEY in:
#   Project Settings → Environment Variables

# Server-side key (preferred — never exposed to browser)
GEMINI_API_KEY=your_gemini_api_key_here

# Public key (used as fallback)
NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
